@startuml
' ============================================
' 设备管理与遥测数据流 - 详细用例图
' ============================================

left to right direction
skinparam packageStyle rectangle

actor "系统管理员\n(ADMIN)" as Admin
actor "运维人员\n(OPERATOR)" as Operator
actor "查看者\n(VIEWER)" as Viewer
actor "物联网传感器\n(IoT Sensor)" as Sensor
actor "物联网执行器\n(IoT Actuator)" as Actuator
actor "EMQX Broker" as MQTT

rectangle "设备与遥测系统" {

  package "设备注册与发现" {
    usecase "注册新设备" as UC_Register
    usecase "设备自发现\n(GET /devices/self)" as UC_SelfDiscover
  }

  package "传感器管理" {
    usecase "创建传感器设备" as UC_CreateSensor
    usecase "编辑传感器设备" as UC_UpdateSensor
    usecase "删除传感器设备" as UC_DeleteSensor
    usecase "创建传感器通道" as UC_CreateSensorCh
    usecase "编辑传感器通道" as UC_UpdateSensorCh
    usecase "删除传感器通道" as UC_DeleteSensorCh
    usecase "查看传感器列表" as UC_ListSensor
  }

  package "执行器管理" {
    usecase "创建执行器设备" as UC_CreateActuator
    usecase "编辑执行器设备" as UC_UpdateActuator
    usecase "删除执行器设备" as UC_DeleteActuator
    usecase "创建执行器通道" as UC_CreateActuatorCh
    usecase "编辑执行器通道" as UC_UpdateActuatorCh
    usecase "删除执行器通道" as UC_DeleteActuatorCh
    usecase "查看执行器列表" as UC_ListActuator
  }

  package "遥测数据" {
    usecase "设备上报遥测数据\n(MQTT → Backend → InfluxDB)" as UC_TelemetryIngest
    usecase "查询时序数据\n(InfluxDB)" as UC_Query
    usecase "查看通道最新值" as UC_Latest
    usecase "查看通道历史" as UC_History
    usecase "删除遥测数据" as UC_DeleteTelemetry
  }

  package "指标定义 (Metric)" {
    usecase "查看指标定义\n(温度/湿度/pH/EC等)" as UC_ListMetric
    usecase "查看指标详情" as UC_GetMetric
  }

  package "实时事件流 (SSE)" {
    usecase "订阅遥测事件" as UC_SSETelemetry
    usecase "订阅设备状态" as UC_SSEDevice
    usecase "订阅命令事件" as UC_SSECommand
    usecase "订阅告警事件" as UC_SSEAlert
  }
}

' Admin: 删除权限
Admin --> UC_DeleteSensor
Admin --> UC_DeleteSensorCh
Admin --> UC_DeleteActuator
Admin --> UC_DeleteActuatorCh
Admin --> UC_DeleteTelemetry

' Operator: CRUD + 数据写入
Operator --> UC_CreateSensor
Operator --> UC_UpdateSensor
Operator --> UC_CreateSensorCh
Operator --> UC_UpdateSensorCh
Operator --> UC_CreateActuator
Operator --> UC_UpdateActuator
Operator --> UC_CreateActuatorCh
Operator --> UC_UpdateActuatorCh
Operator --> UC_Register
Operator --> UC_TelemetryIngest

' Viewer: 只读
Viewer --> UC_ListSensor
Viewer --> UC_ListActuator
Viewer --> UC_Query
Viewer --> UC_Latest
Viewer --> UC_History
Viewer --> UC_ListMetric
Viewer --> UC_GetMetric
Viewer --> UC_SSETelemetry
Viewer --> UC_SSEDevice
Viewer --> UC_SSEAlert

' IoT 设备
Sensor --> UC_TelemetryIngest : MQTT Publish
Actuator --> UC_SSECommand : SSE Subscribe
Actuator --> UC_SelfDiscover

' MQTT 中介
MQTT ..> UC_TelemetryIngest : <<转发>>

@enduml
