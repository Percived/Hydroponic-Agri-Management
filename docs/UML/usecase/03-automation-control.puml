@startuml
' ============================================
' 自动化控制系统 - 详细用例图
' ============================================

left to right direction
skinparam packageStyle rectangle

actor "系统管理员\n(ADMIN)" as Admin
actor "运维人员\n(OPERATOR)" as Operator
actor "查看者\n(VIEWER)" as Viewer
actor "系统调度器\n(Scheduler)" as Scheduler
actor "物联网设备\n(IoT Device)" as Device

rectangle "自动化控制系统" {

  package "策略管理 (Policy)" {
    usecase "创建控制策略\n(含嵌套条件/目标)" as UC_CreatePolicy
    usecase "编辑策略" as UC_UpdatePolicy
    usecase "删除策略" as UC_DeletePolicy
    usecase "查看策略列表" as UC_ListPolicy
    usecase "发布策略" as UC_PublishPolicy
    usecase "归档策略" as UC_ArchivePolicy
    usecase "手动执行策略" as UC_ExecutePolicy
  }

  package "策略条件与目标" {
    usecase "创建触发条件\n(阈值/定时)" as UC_CreateCondition
    usecase "编辑条件" as UC_UpdateCondition
    usecase "删除条件" as UC_DeleteCondition
    usecase "创建执行目标\n(设备+动作)" as UC_CreateTarget
    usecase "编辑目标" as UC_UpdateTarget
    usecase "删除目标" as UC_DeleteTarget
  }

  package "气候曲线管理 (Climate)" {
    usecase "创建气候曲线" as UC_CreateProfile
    usecase "编辑气候曲线" as UC_UpdateProfile
    usecase "删除气候曲线" as UC_DeleteProfile
    usecase "创建气候阶段" as UC_CreateClimStage
    usecase "配置阶段动作\n(温/湿/光/CO2/通风)" as UC_CreateAction
    usecase "执行气候曲线" as UC_ExecuteProfile
  }

  package "命令调度 (Command)" {
    usecase "创建控制命令" as UC_CreateCommand
    usecase "同步调度(等待ACK)" as UC_SyncDispatch
    usecase "异步调度(即发即忘)" as UC_AsyncDispatch
    usecase "确认命令回执" as UC_AckCommand
    usecase "查看命令与回执" as UC_ViewCommand
  }

  package "执行记录" {
    usecase "查看策略执行记录" as UC_PolicyExecLog
    usecase "查看气候执行日志" as UC_ClimateExecLog
  }
}

' Admin: 发布/归档权限
Admin --> UC_PublishPolicy
Admin --> UC_ArchivePolicy
Admin --> UC_DeletePolicy
Admin --> UC_DeleteProfile

' Operator: 日常策略和气候管理
Operator --> UC_CreatePolicy
Operator --> UC_UpdatePolicy
Operator --> UC_ExecutePolicy
Operator --> UC_CreateCondition
Operator --> UC_UpdateCondition
Operator --> UC_DeleteCondition
Operator --> UC_CreateTarget
Operator --> UC_UpdateTarget
Operator --> UC_DeleteTarget
Operator --> UC_CreateProfile
Operator --> UC_UpdateProfile
Operator --> UC_CreateClimStage
Operator --> UC_CreateAction
Operator --> UC_ExecuteProfile
Operator --> UC_CreateCommand
Operator --> UC_SyncDispatch
Operator --> UC_AsyncDispatch
Operator --> UC_AckCommand

' Viewer: 只读
Viewer --> UC_ListPolicy
Viewer --> UC_PolicyExecLog
Viewer --> UC_ClimateExecLog
Viewer --> UC_ViewCommand

' Scheduler: 自动化
Scheduler --> UC_ExecutePolicy
Scheduler --> UC_ExecuteProfile
Scheduler --> UC_SyncDispatch
Scheduler ..> UC_CreateCondition : <<evaluate>>
Scheduler ..> UC_CreateTarget : <<trigger>>

' IoT Device
Device --> UC_AckCommand

@enduml
